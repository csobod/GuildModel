/* GuildCAM — Guild colour palette
   Background: #ffd580 (amber/gold)
   Text: #1a1a1a (near-black)
   Accent: #c8a040 (darker gold for hover/press)
   Panel: #ffe8a8 (lighter gold for panels/cards)
   Headers: bold, League Spartan or Poppins (fallback: Arial)
*/

QMainWindow, QWidget {
    background-color: #ffd580;
    color: #1a1a1a;
    font-family: "League Spartan", "Poppins", Arial, sans-serif;
    font-size: 13px;
}

QLabel[heading="true"] {
    font-size: 18px;
    font-weight: bold;
    color: #1a1a1a;
}

QPushButton {
    background-color: #1a1a1a;
    color: #ffd580;
    border: none;
    border-radius: 4px;
    padding: 6px 16px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton:hover {
    background-color: #333333;
}

QPushButton:pressed {
    background-color: #000000;
}

QPushButton:disabled {
    background-color: #999999;
    color: #cccccc;
}

QGroupBox {
    background-color: #ffe8a8;
    border: 1px solid #c8a040;
    border-radius: 6px;
    margin-top: 10px;
    padding: 8px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 4px;
    font-weight: bold;
}

QDoubleSpinBox, QSpinBox, QComboBox, QLineEdit {
    background-color: #fff8e8;
    border: 1px solid #c8a040;
    border-radius: 3px;
    padding: 3px 6px;
    color: #1a1a1a;
}

QDoubleSpinBox:focus, QSpinBox:focus, QComboBox:focus, QLineEdit:focus {
    border: 2px solid #1a1a1a;
}

QTabWidget::pane {
    background-color: #ffe8a8;
    border: 1px solid #c8a040;
}

QTabBar::tab {
    background-color: #ffd580;
    border: 1px solid #c8a040;
    padding: 6px 16px;
    font-weight: bold;
}

QTabBar::tab:selected {
    background-color: #ffe8a8;
    border-bottom: none;
}

QScrollBar:vertical {
    background: #ffd580;
    width: 12px;
}

QScrollBar::handle:vertical {
    background: #c8a040;
    border-radius: 6px;
    min-height: 20px;
}
